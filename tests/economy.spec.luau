--!nostrict
local E = require("../src/shared/Economy")
local Config = require("../src/shared/Config")
local Store = require("../src/server/ProfileStore")

return function(h)
 h.test("старый профиль получает пустую кухню без потери денег",function()
  local d=E.load({slices=42,productionRemainder=.5,levels={workers=2,craft=3}})
  h.near(d.slices,42); h.equals(d.levels.temper,0); h.equals(d.decor.plant,false)
  h.near(E.manual(d),4)
 end)
 h.test("оснащение усиливает одинаковую награду игрока и ученика",function()
  local d=E.load({slices=1000,levels={workers=1}})
  assert(E.buy(d,'library_1')); assert(E.buy(d,'temper_1')); assert(E.buy(d,'clock_1'))
  h.near(E.manual(d),3.6); h.near(E.cycleSeconds(d),10/1.1)
  h.near(E.tick(d,E.cycleSeconds(d)),3.6)
  h.near(E.round(d),3.6)
 end)
 h.test("декор покупается один раз и переживает сохранение и престиж",function()
  local d=E.load({slices=1000,earned=5000,levels={kitchen=1}})
  assert(E.buy(d,'plant')); h.near(d.slices,955); h.equals(d.decor.plant,true)
  assert(E.buy(d,'plant')); h.near(d.slices,955); h.equals(d.decor.plant,false)
  d=E.load(d); h.equals(d.decor.plant,false)
  assert(E.buy(d,'temper_1')); assert(E.prestige(d))
  h.equals(d.levels.plant,1); h.equals(d.levels.temper,1); h.equals(d.decor.plant,false)
  assert(E.buy(d,'plant')); h.equals(d.decor.plant,true); h.near(d.slices,0)
  local loaded=E.snapshot(d); loaded.decor.plant=false; h.equals(d.decor.plant,true)
 end)
 h.test("декор не даёт дохода и нельзя включить его без покупки",function()
  local d=E.load({decor={plant=true}})
  h.equals(d.decor.plant,false); h.equals(E.buy(d,'plant'),false)
  h.near(E.manual(d),1); h.near(E.rate(d),0)
 end)

	h.test("ловкость доступна только с первым учеником и остаётся доступна после престижа", function()
		local d = E.load({ slices = 100, earned = 5000 })
		h.equals(E.snapshot(d).prices.speed, nil)
		h.equals(E.buy(d, "speed"), false)
		h.equals(d.slices, 100)
		assert(E.buy(d, "kitchen")); h.equals(E.buy(d, "workers_1"), true)
		h.equals(E.snapshot(d).prices.speed, 40)
		h.equals(E.buy(d, "speed"), true)
		h.equals(E.prestige(d), true)
		h.equals(E.snapshot(d).prices.speed, 40)
		h.equals(E.buy(d, "speed"), false)
	end)
	h.test("ученик получает ручную награду только за полный цикл", function()
		local d = E.load({ levels = { workers = 1 } })
		h.near(E.tick(d, 9.037), 0)
		h.near(E.tick(d, 0.24), 0)
		h.near(E.tick(d, 0.731), E.manual(d))
		h.near(d.slices, 1)
		h.near(d.productionRemainder, 0.0008)
		h.near(E.tick(d, 30.1), 3)
	end)
	h.test("сохранение переносит долю цикла и настоящие бонусы награды", function()
		local d = E.load({ levels = { workers = 1, recipe = 1 } })
		E.tick(d, 7.5)
		local restored = E.load(d)
		h.near(E.tick(restored, 2.5), 1.25)
		h.near(restored.slices, 1.25)
	end)
	h.test("первый ученик стоит 25, мастерство усиливает ручной и автоматический фокус", function()
		local d=E.load({slices=28})
		h.equals(E.price(d,"kitchen"),25)
		assert(E.buy(d,"kitchen")); h.equals(E.buy(d,"workers_1"),true)
		h.equals(E.buy(d,"craft"),true)
		h.near(E.tick(d,E.cycleSeconds(d)),E.round(d))
		h.near(d.slices,4)
	end)
	h.test("ловкость ускоряет циклы без потери прогресса и без изменения награды", function()
		local d=E.load({slices=40,levels={workers=2,craft=3}})
		E.tick(d,5)
		local reward=E.manual(d)
		h.equals(E.buy(d,"speed"),true)
		h.near(E.cycleSeconds(d),10/1.2)
		h.near(d.productionRemainder,0.5)
		h.near(E.tick(d,E.cycleSeconds(d)*0.5),reward*2)
		h.near(E.manual(d),reward)
	end)
	h.test("старые шоколатье становятся учениками без сброса покупок и остатка", function()
		local d=E.load({slices=123.4,productionRemainder=0.75,levels={workers=13,craft=9,recipe=8}})
		h.equals(d.levels.workers,13); h.equals(d.levels.speed,0)
		h.equals(d.levels.craft,9); h.near(d.slices,123.4)
		h.near(E.tick(d,2.5),13*E.manual(d))
	end)
	h.test("старые случайные сотые исправляются один раз без потери баланса", function()
		local d = E.load({ slices = 3.49 })
		h.near(d.slices, 3.5)
		h.near(E.load(d).slices, 3.5)
		local boosted = E.load({ slices = 3.25, stars = 1 })
		h.near(boosted.slices, 3.25)
	end)

	h.test("первые три фокуса дают первое улучшение и удваивают ручной доход", function()
		local d = E.load(nil)
		for _ = 1, 3 do E.round(d) end
		h.equals(E.buy(d, "craft"), true)
		h.equals(d.slices, 0)
		h.equals(E.round(d), 2)
		h.equals(d.rounds, 4)
	end)
	h.test("покупка без денег, неизвестный товар и повторная покупка не списывают баланс", function()
		local d = E.load({ slices = 3 })
		h.equals(E.buy(d, "workers_1"), false)
		h.equals(E.buy(d, {}), false)
		h.equals(E.buy(d, "free"), false)
		h.equals(E.buy(d, "craft"), true)
		h.equals(E.buy(d, "craft"), false)
		h.equals(d.levels.craft, 1)
		h.equals(d.slices, 0)
	end)
	h.test("дробный доход не теряется и не зависит от частоты тиков", function()
		local a = E.load({ levels = { workers = 1 } })
		local b = E.load(a)
		for _ = 1, 100 do E.tick(a, 0.1) end
		E.tick(b, 10)
		h.near(a.slices, 1)
		h.near(a.slices, b.slices)
	end)
	h.test("рецептура и звёзды усиливают оба вида дохода", function()
		local d = E.load({ stars = 2, levels = { workers = 5, craft = 3, recipe = 2 } })
		h.near(E.manual(d), 9)
		h.near(E.rate(d), 4.5)
	end)
	h.test("новое ателье сохраняет коллекцию, звёзды и статистику, сбрасывая навыки и баланс", function()
		local d = E.load({ slices = 200, earned = 20000, lifetime = 21000, rounds = 30,
			stars = 3, levels = { craft = 2, workers = 4 } })
		h.equals(E.prestige(d), true)
		h.equals(d.stars, 5)
		h.equals(d.slices, 0)
		h.equals(d.earned, 0)
		h.equals(d.lifetime, 21000)
		h.equals(d.rounds, 30)
		h.equals(d.levels.workers, 4)
		h.equals(E.prestige(d), false)
	end)
	h.test("повреждённые числа и предельные уровни не ломают экономику", function()
		local d = E.load({ slices = 0/0, earned = math.huge, stars = -4, levels = { craft = 100000, workers = "99" } })
		h.equals(d.slices, 0)
		h.equals(d.earned, 0)
		h.equals(d.stars, 0)
		h.equals(E.price(d, "craft"), Config.Economy.maxValue)
		h.equals(E.buy(d, "craft"), false)
		h.equals(d.levels.workers, 0)
	end)
	h.test("офлайн ограничен четырьмя часами и не начисляется за отрицательное время", function()
		local d = E.load({ levels = { workers = 1 } })
		h.near(E.tick(d, 1000000), 1440)
		h.equals(E.tick(d, -100), 0)
	end)
	h.test("снимок для UI не может изменить серверные уровни", function()
		local d = E.load(nil)
		local state = E.snapshot(d)
		state.levels.craft = 100
		h.equals(d.levels.craft, 0)
		h.equals(state.prices.craft, 3)
	end)

	local function fixture()
		local now = 1000
		local record
		local fake = { UpdateAsync = function(_, _, transform)
			local updated = transform(record)
			if updated then record = updated end
			return updated
		end }
		return Store.new(fake, E, Config.Economy, "A", function() return now end),
			Store.new(fake, E, Config.Economy, "B", function() return now end),
			function(t) now = t end, function() return record end
	end
	h.test("второй сервер не захватывает активное сохранение", function()
		local a, b = fixture()
		local d = a:claim("user")
		E.credit(d, 99)
		h.equals(a:save("user", d, false), true)
		h.equals(b:claim("user"), nil)
	end)
	h.test("выход и вход сохраняют покупки и начисляют офлайн только один раз", function()
		local a, b, time = fixture()
		local d = a:claim("user")
		E.credit(d, 25)
		E.buy(d, "kitchen"); E.buy(d, "workers_1")
		a:save("user", d, true)
		time(1100)
		local loaded, offline = b:claim("user")
		h.near(offline, 10)
		h.near(loaded.slices, 10)
		local again, twice = b:claim("user")
		h.equals(twice, 0)
		h.near(again.slices, 10)
	end)
	h.test("просроченный сервер не перезаписывает захваченный другим профиль", function()
		local a, b, time, record = fixture()
		local stale = a:claim("user")
		time(1400)
		local fresh = b:claim("user")
		E.credit(fresh, 77)
		b:save("user", fresh, false)
		h.equals(a:save("user", stale, true), false)
		h.near(record().data.slices, 77)
	end)
	h.test("ошибка загрузки не записывает пустой профиль", function()
		local calls = 0
		local store = Store.new({ UpdateAsync = function() calls += 1; error("network") end }, E, Config.Economy, "A", function() return 1000 end)
		local ok = pcall(function() store:claim("user") end)
		h.equals(ok, false)
		h.equals(calls, 1)
	end)
 h.test('хранилище переводит старую запись в формат коллекции и не читает будущую версию',function()
  local record={version=1,savedAt=1000,data={slices=200,levels={workers=7,clock=4}}}
  local store=Store.new({UpdateAsync=function(_,_,transform) local next=transform(record); if next then record=next end; return next end},E,Config.Economy,'A',function() return 1000 end)
  local data=store:claim('user'); h.equals(record.version,2)
  h.equals(data.levels.workers,7); assert(data.owned.clock_4); h.equals(data.equipped.clock,'clock_4')
  assert(store:save('user',data,true)); h.equals(record.data.collectionVersion,1)
  record.version=3; h.equals(store:claim('user'),nil); h.equals(record.version,3)
 end)

end
