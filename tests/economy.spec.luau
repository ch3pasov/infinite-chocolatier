--!nostrict
local E = require("../src/shared/Economy")
local Config = require("../src/shared/Config")
local Store = require("../src/server/ProfileStore")

return function(h)
	h.test("дрожание таймера не создаёт сотых у первого шоколатье", function()
		local d = E.load({ levels = { workers = 1 } })
		h.near(E.tick(d, 1.037), 0.2)
		h.near(E.tick(d, 0.24), 0)
		h.near(E.tick(d, 0.731), 0.2)
		h.near(d.slices, 0.4)
		h.near(d.productionRemainder, 0.008)
		h.near(E.tick(d, 3.1), 0.6)
		h.near(d.slices, 1)
	end)
	h.test("сохранение переносит неполную секунду, бонусы сохраняют законные сотые", function()
		local d = E.load({ levels = { workers = 1, recipe = 1 } })
		E.tick(d, 0.75)
		local restored = E.load(d)
		h.near(E.tick(restored, 0.25), 0.25)
		h.near(restored.slices, 0.25)
	end)
	h.test("старые случайные сотые исправляются один раз без потери баланса", function()
		local d = E.load({ slices = 3.49 })
		h.near(d.slices, 3.5)
		h.near(E.load(d).slices, 3.5)
		local boosted = E.load({ slices = 3.25, stars = 1 })
		h.near(boosted.slices, 3.25)
	end)

	h.test("первые три фокуса дают первое улучшение и удваивают ручной доход", function()
		local d = E.load(nil)
		for _ = 1, 3 do E.round(d) end
		h.equals(E.buy(d, "craft"), true)
		h.equals(d.slices, 0)
		h.equals(E.round(d), 2)
		h.equals(d.rounds, 4)
	end)
	h.test("покупка без денег, неизвестный товар и повторная покупка не списывают баланс", function()
		local d = E.load({ slices = 3 })
		h.equals(E.buy(d, "workers"), false)
		h.equals(E.buy(d, {}), false)
		h.equals(E.buy(d, "free"), false)
		h.equals(E.buy(d, "craft"), true)
		h.equals(E.buy(d, "craft"), false)
		h.equals(d.levels.craft, 1)
		h.equals(d.slices, 0)
	end)
	h.test("дробный доход не теряется и не зависит от частоты тиков", function()
		local a = E.load({ levels = { workers = 1 } })
		local b = E.load(a)
		for _ = 1, 100 do E.tick(a, 0.1) end
		E.tick(b, 10)
		h.near(a.slices, 2)
		h.near(a.slices, b.slices)
	end)
	h.test("рецептура и звёзды усиливают оба вида дохода", function()
		local d = E.load({ stars = 2, levels = { workers = 5, craft = 3, recipe = 2 } })
		h.near(E.manual(d), 9)
		h.near(E.rate(d), 2.25)
	end)
	h.test("новое ателье сохраняет звёзды и статистику, сбрасывая покупки и баланс", function()
		local d = E.load({ slices = 200, earned = 20000, lifetime = 21000, rounds = 30,
			stars = 3, levels = { craft = 2, workers = 4 } })
		h.equals(E.prestige(d), true)
		h.equals(d.stars, 5)
		h.equals(d.slices, 0)
		h.equals(d.earned, 0)
		h.equals(d.lifetime, 21000)
		h.equals(d.rounds, 30)
		h.equals(d.levels.workers, 0)
		h.equals(E.prestige(d), false)
	end)
	h.test("повреждённые числа и предельные уровни не ломают экономику", function()
		local d = E.load({ slices = 0/0, earned = math.huge, stars = -4, levels = { craft = 100000, workers = "99" } })
		h.equals(d.slices, 0)
		h.equals(d.earned, 0)
		h.equals(d.stars, 0)
		h.equals(E.price(d, "craft"), nil)
		h.equals(E.buy(d, "craft"), false)
		h.equals(d.levels.workers, 0)
	end)
	h.test("офлайн ограничен четырьмя часами и не начисляется за отрицательное время", function()
		local d = E.load({ levels = { workers = 1 } })
		h.near(E.tick(d, 1000000), 2880)
		h.equals(E.tick(d, -100), 0)
	end)
	h.test("снимок для UI не может изменить серверные уровни", function()
		local d = E.load(nil)
		local state = E.snapshot(d)
		state.levels.craft = 100
		h.equals(d.levels.craft, 0)
		h.equals(state.prices.craft, 3)
	end)

	local function fixture()
		local now = 1000
		local record
		local fake = { UpdateAsync = function(_, _, transform)
			local updated = transform(record)
			if updated then record = updated end
			return updated
		end }
		return Store.new(fake, E, Config.Economy, "A", function() return now end),
			Store.new(fake, E, Config.Economy, "B", function() return now end),
			function(t) now = t end, function() return record end
	end
	h.test("второй сервер не захватывает активное сохранение", function()
		local a, b = fixture()
		local d = a:claim("user")
		E.credit(d, 99)
		h.equals(a:save("user", d, false), true)
		h.equals(b:claim("user"), nil)
	end)
	h.test("выход и вход сохраняют покупки и начисляют офлайн только один раз", function()
		local a, b, time = fixture()
		local d = a:claim("user")
		E.credit(d, 12)
		E.buy(d, "workers")
		a:save("user", d, true)
		time(1100)
		local loaded, offline = b:claim("user")
		h.near(offline, 20)
		h.near(loaded.slices, 20)
		local again, twice = b:claim("user")
		h.equals(twice, 0)
		h.near(again.slices, 20)
	end)
	h.test("просроченный сервер не перезаписывает захваченный другим профиль", function()
		local a, b, time, record = fixture()
		local stale = a:claim("user")
		time(1400)
		local fresh = b:claim("user")
		E.credit(fresh, 77)
		b:save("user", fresh, false)
		h.equals(a:save("user", stale, true), false)
		h.near(record().data.slices, 77)
	end)
	h.test("ошибка загрузки не записывает пустой профиль", function()
		local calls = 0
		local store = Store.new({ UpdateAsync = function() calls += 1; error("network") end }, E, Config.Economy, "A", function() return 1000 end)
		local ok = pcall(function() store:claim("user") end)
		h.equals(ok, false)
		h.equals(calls, 1)
	end)
end
